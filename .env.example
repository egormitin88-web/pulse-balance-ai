# Copy to .env.local only for local configuration. Never commit real values.
# Empty DATABASE_URL uses local SQLite. Neon supplies a PostgreSQL connection URL.
DATABASE_URL=
OPENAI_API_KEY=
# Required in Vercel: at least 32 random characters, stable across deployments.
FITNESS_SESSION_SECRET=
# Set to 1 in Vercel (HTTPS); leave 0 for local HTTP.
FITNESS_SECURE_COOKIES=0
# Local Neon connection: auto, tcp, or websocket. Vercel always uses TCP.
FITNESS_NEON_TRANSPORT=auto
